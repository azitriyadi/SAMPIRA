# EcoRecycle Database & Security Configuration Template
# Salin file ini menjadi '.env' dan sesuaikan nilainya dengan server Anda.

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=ecorecycle

# Key untuk tanda tangan token HMAC SHA-256 (Ganti dengan string random yang panjang)
JWT_SECRET=

# Batasi alamat listen untuk pengembangan atau origin di belakang reverse proxy.
SAMPIRA_LISTEN_HOST=127.0.0.1
# true untuk aplikasi HTTPS di belakang proxy tepercaya.
SAMPIRA_SECURE_COOKIE=false

# Akun demo semua role dibuat hanya oleh go run ./db_init pada DB BARU.
# Kosongkan agar password acak dibuat dan ditampilkan sekali di terminal.
# Jika diisi, gunakan password berbeda untuk setiap role, 15–72 byte.
SAMPIRA_INITIAL_USER_PASSWORD=
SAMPIRA_INITIAL_PETUGAS_PASSWORD=
SAMPIRA_INITIAL_ADMIN_PASSWORD=
SAMPIRA_INITIAL_ADMINISTRATOR_PASSWORD=
